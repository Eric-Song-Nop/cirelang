  "integer_policy": {
    "checked_named_operations": [
      "checked_abs",
      "checked_add",
      "checked_div",
      "checked_mul",
      "checked_neg",
      "checked_rem",
      "checked_shl",
      "checked_shr",
      "checked_sub"
    ],
    "default_operations": "MayTrapV1+DefectTransitionV1",
    "implicit_typed_conversion": false,
    "saturating_named_operations": [
      "saturating_add",
      "saturating_mul",
      "saturating_sub"
    ],
    "wrapping_named_operations": [

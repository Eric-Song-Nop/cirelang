// profile: Cire-TR₀/2026-07-31
// expect: accept
// rule: T-Delay; T-Operation(FrameClock.yield); T-Advance
// oracle: type=Int; row={frame}; world=next(frame); suspension=MaySuspend; captures={}

def![F : FrameClock] next_value(
  frame : cap F,
  value : Int,
) -> Next[frame, Int] {
  delay[frame] { value + 1 }
}

def![F : FrameClock] after_tick(
  frame : cap F,
  pending : Next[frame, Int],
) -> Int ! {frame} {
  frame.yield()
  advance(pending)
}

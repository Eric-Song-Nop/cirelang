// profile: Cire-v1.0
// expect: accept
// sealed prelude: FrameClock, Next, delay, advance

def![F : FrameClock] next_value(
  frame : F,
  value : Int,
) -> Next[frame, Int] ! {} {
  delay[frame] { value + 1 }
}

def![F : FrameClock] after_tick(
  frame : F,
  pending : Next[frame, Int],
) -> Int ! {frame} {
  frame.yield()
  advance(pending)
}

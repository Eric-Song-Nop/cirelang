// profile: Cire-TR₀/2026-07-31
// expect: accept
// rule: RowExpr kinding and union normalization
// oracle: type=(A)->C!(E1|E2); row=E1|E2; constraints=kind(E1)=kind(E2)=EffectRow

def[A, B, C]![..E1, ..E2] compose(
  first : (A) -> B ! E1,
  second : (B) -> C ! E2,
) -> (A) -> C ! (E1 | E2) {
  fn(value) { second(first(value)) }
}

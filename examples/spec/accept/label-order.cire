// oracle: subject=demo; ambient=View helper prelude; type=View; row={}; labels={enabled,gap}; eval=make_title,is_enabled,measure_gap

def panel(title : String, gap~ : Int, enabled~ : Bool) -> View {
  Column(gap~) {
    Text(title)
    Button("Save", enabled~) { save() }
  }
}

def demo() -> View {
  panel(make_title(), enabled=is_enabled(), gap=measure_gap())
}

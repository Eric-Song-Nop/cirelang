def panel(title : String, gap~ : Int, enabled~ : Bool) -> View {
  Column(gap~) {
    Text(title)
    Button("Save", enabled~) { save() }
  }
}

def demo() -> View {
  panel(make_title(), enabled=is_enabled(), gap=measure_gap())
}

// profile: Cire-v1.0
// expect: accept

ability Reader[A] {
  fun read() -> A
}

effect State[A] : Reader[A] {}

def[A]![F : Reader[A]] read_from(
  reader : F,
) -> A ! {reader} {
  reader.read()
}

def demo() -> Int ! {} {
  with State[Int] {
    fun read() => 42
  } as state
  in {
    read_from(state)
  }
}

// profile: Cire-TR₀/2026-08-01
// expect: accept
// rule: associated Type/Effect/EffectRow kinding and effect-header ability conformance
// oracle: subject=load_file; ambient=Path/IoFailure/Async/Blocking nominal effects; type=Int; row={store,FileStore::Fail}|FileStore::Extra; associated=Key:Type,Fail:Effect,Extra:EffectRow; impl=effect-header-local

ability Store {
  type Key
  effect Fail
  effects Extra : Lacks[Blocking] = {}

  fun get(key : Key) -> Int ! {Fail}
}

effect FileStore
  : Store[
      Key = Path,
      Fail = IoFailure,
      Extra = {Async},
    ] {}

def load_file(
  store : cap FileStore,
  key : FileStore::Key,
) -> Int ! ({store, FileStore::Fail} | FileStore::Extra) {
  store.get(key)
}

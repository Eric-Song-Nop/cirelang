// profile: Cire-TR₀/2026-08-01
// expect: accept
// rule: T-Pack-Next-Paths + T-Try-With-PackedNext-Paths
// oracle: subject=open_packed; ambient=sealed @temporal intrinsics/Owner prelude; type=Option[Int]; flow={Returns(Some(42)),Returns(None)}; suspension=MaySuspend(frame.yield); lease_release=exactly-once-per-won-path

def open_packed(owner : Owner) -> Option[Int] {
  let packed = @temporal::pack_next(under=owner) { frame =>
    delay[frame] { 42 }
  }

  @temporal::try_with_packed_next(packed) { frame, pending =>
    frame.yield()
    advance(pending)
  }
}

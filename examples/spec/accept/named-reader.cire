// profile: Cire-TR₀/2026-07-31
// expect: accept
// rule: Ability/Effect kinds; T-Handler; identity return synthesis; identity nonescape
// oracle: type=Int; row={}; world=same; captures={}; identity=state-does-not-escape

pub(open) ability Reader[A] {
  fun read() -> A
}

pub(open) effect State[A] : Reader[A] {}

def[A]![F : Reader[A]] read_from(app : cap F) -> A ! {app} {
  app.read()
}

def demo() -> Int {
  with handler State[Int] {
    fun read() => 42
  } as state
  in {
    read_from(state)
  }
}

// profile: Cire-TR₀/2026-07-31
// expect: accept
// rule: T-Operation; T-Handler; T-Resume; T-Finalize
// oracle: subject=demo; ambient=Control effect/handler prelude; type=Array[Int]; row={}; world=same; captures={}; usage=all-resumptions-closed; owner=none

pub(open) effect Workflow[A, E] {
  fun default() -> A
  abort[B] raise(error : E) -> B
  once checkpoint(value : A) -> A
  ctl choose(values : Array[A]) -> A
}

def demo() -> Array[Int] {
  with handler Workflow[Int, String] {
    fun default() => 41
    abort raise(_error) => []
    once checkpoint(value) as k => k.resume(value)
    ctl choose(values) as k => {
      let left = k.resume(values[0])
      let right = k.resume(values[1])
      k.finalize()
      left.concat(right)
    }
    return(value) => [value]
  }
  in {
    Workflow::choose([Workflow::default(), 42])
  }
}

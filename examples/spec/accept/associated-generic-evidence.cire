// profile: Cire-TR₀/2026-08-01
// expect: accept
// rule: generic associated equality is partial symbolic evidence; defaults apply only to concrete headers
// oracle: subject=load_as; ambient=Store ability/A Type/S Effect generic/Blocking effect; type=A; row={store,S::Fail}|S::Extra; associated=Key:Type(symbolic),Value:Type(eq A),Fail:Effect(symbolic),Extra:EffectRow(symbolic-not-default)

ability Store {
  type Key
  type Value
  effect Fail
  effects Extra : Lacks[Blocking] = {}

  fun get(key : Key) -> Value ! {Fail}
}

def[A]![S : Store[Value = A]] load_as(
  store : cap S,
  key : S::Key,
) -> A ! ({store, S::Fail} | S::Extra) {
  store.get(key)
}

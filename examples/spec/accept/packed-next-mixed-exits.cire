// profile: Cire-TR₀/2026-08-01
// expect: accept
// rule: T-Try-With-PackedNext-Paths — Returns, Aborts and two Transfers each release once and preserve tag
// oracle: subject=open_mixed; ambient=sealed @temporal/CompletionSource/Owner/Task prelude; type=Option[Int]; flow={Returns(None),Returns(Some(Int)),Aborts,Transfers(site1),Transfers(site2)}; won_path_release_count=1; terminal_tags=preserved

effect Exit {
  abort stop() -> Never
}

effect Async {
  once[A] await(task : Task[A]) -> A may_suspend
}

def open_mixed(
  packed : PackedNext[Int],
  owner : Owner,
  task1 : Task[Int],
  task2 : Task[Int],
  source1 : CompletionSource[Int],
  source2 : CompletionSource[Int],
  mode : Int,
) -> Option[Int] ! {Exit} {
  @temporal::try_with_packed_next(packed) { frame, pending =>
    if mode == 0 {
      frame.yield()
      advance(pending)
    } else if mode == 1 {
      Exit::stop()
    } else if mode == 2 {
      with handler Async {
        once await(_task) as k => source1.park(k, under=owner)
        return(value) => value
      }
      in Async::await(task1)
    } else {
      with handler Async {
        once await(_task) as k => source2.park(k, under=owner)
        return(value) => value
      }
      in Async::await(task2)
    }
  }
}

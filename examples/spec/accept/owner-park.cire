// profile: Cire-TR₀/2026-08-01
// expect: accept
// rule: T-Park — sealed source produces terminal Transfers(ParkContractV2)
// oracle: subject=run_async; ambient=CompletionSource/Owner/Task prelude; declared_type=Int; flow={Transfers(ParkContractV2)}; row={}; usage=k:Transferred; owner=generation-CAS

effect Async {
  once[A] await(task : Task[A]) -> A may_suspend
}

def run_async(
  task : Task[Int],
  source : CompletionSource[Int],
  owner : Owner,
) -> Int {
  with handler Async {
    once await(_task) as k =>
      source.park(k, under = owner)
    return(value) => value
  }
  in {
    Async::await(task)
  }
}

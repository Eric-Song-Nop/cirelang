// profile: Cire-TR₀/2026-08-01
// expect: reject
// rule: TR₀ resumption primitives expose resume/finalize, not discontinue
// oracle: subject=bad; ambient=Async effect/Task prelude; reject_at=k.discontinue; diagnostic=unknown-resumption-primitive

effect Async {
  once await(task : Task[Int]) -> Int may_suspend
}

def bad(task : Task[Int]) -> Int {
  with handler Async {
    once await(_task) as k => k.discontinue("cancelled")
    return(value) => value
  }
  in {
    Async::await(task)
  }
}

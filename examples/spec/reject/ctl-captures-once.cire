// profile: Cire-TR₀/2026-07-31
// expect: reject
// rule: T-Capture-Ctl / DuplicableEnv

effect OneShot {
  once obtain() -> Int
}

effect Choice {
  ctl choose(values : Array[Int]) -> Int
}

def bad() -> Int {
  with handler OneShot {
    once obtain() as k => {
      with handler Choice {
        ctl choose(values) as choice_k => {
          let left = choice_k.resume(values[0])
          let right = choice_k.resume(values[1])
          choice_k.finalize()
          left + right
        }
      }
      in {
        k.resume(Choice::choose([1, 2]))
      }
    }
    return(value) => value
  }
  in {
    OneShot::obtain()
  }
}

// profile: Cire-TR₀/2026-07-31
// expect: reject
// rule: T-Park — Transfers(ParkContract) has no expression result
// oracle: subject=bad; ambient=CompletionSource/Owner/Resume prelude; reject_at=let-binding; diagnostic=terminal-transfer-has-no-value; flow=Transfers(ParkContract)

effect Async {
  once[A] await(task : Task[A]) -> A may_suspend
}

def bad(
  task : Task[Int],
  source : CompletionSource[Int],
  owner : Owner,
) -> Int {
  with handler Async {
    once await(_task) as k => {
      let _parked = source.park(k, under = owner)
      0
    }
    return(value) => value
  }
  in {
    Async::await(task)
  }
}
